{
  "color": {
    "$type": "color",
    "primary": { "$value": "#ac1d23" },
    "secondary": { "$value": "#808080" },
    "tertiary": { "$value": "#b3a285" },
    "background": { "$value": "#f5f5f5" },
    "success": { "$value": "#008577" },
    "black": { "$value": "#000" },
    "white": { "$value": "#fff" },
    "light-grey": { "$value": "#f5f5f5" },

    "text": {
      "$type": "color",
      "primary": {
        "default": {
          "$value": "{color.primary}"
        },
        "selected": {
          "$value": "#b52828"
        }
      },
      "secondary": {
        "$value": "#808080"
      }
    }
  },

  "text": {
    "font": {
      "$type": "fontFamily",
      "inter": {
        "$value": ["Inter Variable", "sans-serif"]
      },
      "open-sans": {
        "$value": ["Open Sans Variable", "sans-serif"]
      },
      "libre-baskerville": {
        "$value": ["Libre Baskerville", "serif"]
      }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "inter": {
        "$value": ["Inter Variable", "sans-serif"]
      },
      "open-sans": {
        "$value": ["Open Sans Variable", "sans-serif"]
      },
      "libre-baskerville": {
        "$value": ["Libre Baskerville", "serif"]
      }
    },
    "size": {
      "$type": "dimension",
      "1": { "$value": "14px" },
      "2": { "$value": "18px" },
      "3": { "$value": "21px" },
      "4": { "$value": "24px" },
      "5": { "$value": "28px" },
      "6": { "$value": "36px" }
    }
  },

  "border": {
    "radius": {
      "$type": "dimension",
      "1": { "$value": "6px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" }
    }
  },

  "custom-gradient": {
    "$type": "gradient",
    "1": {
      "$value": [
        { "color": "#6f3411", "position": 0.3958 },
        { "color": "#bd9007", "position": 1 }
      ]
    },
    "2": {
      "$value": [
        { "color": "#051329", "position": 0.3958 },
        { "color": "#037dbc", "position": 1 }
      ]
    },
    "3": {
      "$value": [
        { "color": "#014343", "position": 0.3958 },
        { "color": "#029674", "position": 1 }
      ]
    }
  }
}
