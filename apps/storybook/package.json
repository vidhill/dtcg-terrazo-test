{
  "name": "terrazzo-storybook-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens:normalize": "normalize-tokens @repo/tokens src .tokens",
    "tokens:watch": "chokidar \"../../packages/tokens/src/**/*\" --initial -c \"pnpm tokens:normalize\"",
    "tokens": "pnpm tokens:normalize && tz build",
    "storybook": "concurrently -k -n tokens,storybook \"pnpm tokens:watch\" \"storybook dev -p 6006 --no-open\"",
    "build-storybook": "pnpm tokens:normalize && storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run lint:js && pnpm run typecheck",
    "lint:js": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@repo/normalize-tokens": "workspace:*",
    "@repo/swatchbook-components": "workspace:*",
    "@repo/tokens": "workspace:*",
    "@repo/react-app": "workspace:*",
    "@unpunnyfuns/swatchbook-addon": "^2.2.0",
    "@unpunnyfuns/swatchbook-core": "^2.2.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@terrazzo/cli": "catalog:",
    "@terrazzo/plugin-css": "catalog:",
    "@types/node": "^26.6.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@unpunnyfuns/swatchbook-blocks": "catalog:",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.6",
    "eslint": "catalog:",
    "storybook": "^10.6.1",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
